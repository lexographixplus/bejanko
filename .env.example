# ── Database ──────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ── Auth (NextAuth v5) ────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET="your-secret-here"
AUTH_URL="http://localhost:3000"

# ── Site ──────────────────────────────────────────────
# Canonical origin, no trailing slash. Used for sitemap, RSS, OG tags and
# email links. On Vercel this falls back to the deployment URL if unset.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Cloudinary (images & contest attachments) ─────────
# The API key is public by design — signed uploads need it in the browser.
# The secret stays server-side and signs uploads via /api/upload.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ── Resend (transactional email) ──────────────────────
RESEND_API_KEY="re_your_key"
# Must be a verified sender/domain in Resend.
EMAIL_FROM="B.E. Janko Jnr <hello@bejanko.com>"
# Where contact messages and submission alerts are delivered.
CONTACT_EMAIL="hello@bejanko.com"
